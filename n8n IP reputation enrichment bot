    {
      "parameters": {
        "jsCode": "// Runs after the Merge node: one item holding BOTH sources' fields.\nconst j = $input.first().json;\nconst base = $('Parse Command').first().json;\nconst arr = v => (Array.isArray(v) ? v : []);\n\nconst ipintel = {\n  status: j.status,\n  message: j.message,\n  country: j.country,\n  region: j.regionName,\n  city: j.city,\n  isp: j.isp,\n  org: j.org,\n  asn: j.as,\n  asname: j.asname,\n  reverse: j.reverse,\n  proxy: j.proxy,\n  hosting: j.hosting,\n  mobile: j.mobile\n};\nconst internetdb = {\n  noData: !Array.isArray(j.ports),\n  ports: arr(j.ports),\n  hostnames: arr(j.hostnames),\n  cpes: arr(j.cpes),\n  tags: arr(j.tags),\n  vulns: arr(j.vulns)\n};\nreturn [{ json: { chatId: base.chatId, ip: base.ip, ipintel, internetdb } }];"
      },
      "id": "a0000000-0000-4000-8000-000000000009",
      "name": "Prepare Evidence",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
