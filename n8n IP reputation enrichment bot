    {
      "parameters": {
        "jsCode": "const base = $('Prepare Evidence').first().json;\nconst raw = String($input.first().json.output || '');\nlet r = {};\ntry {\n  const m = raw.match(/\\{[\\s\\S]*\\}/);\n  r = JSON.parse(m ? m[0] : raw);\n} catch (e) { r = {}; }\n\nconst allowed = ['CLEAN', 'SUSPICIOUS', 'MALICIOUS', 'UNKNOWN'];\nconst v = String(r.verdict || '').toUpperCase();\nconst verdict = allowed.includes(v) ? v : 'UNKNOWN';\nconst badge = { CLEAN: '🟢', SUSPICIOUS: '🟡', MALICIOUS: '🔴', UNKNOWN: '⚪' }[verdict];\n\nconst esc = s => String(s == null || s === '' ? 'n/a' : s)\n  .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nconst yn = x => (x === true ? 'yes' : x === false ? 'no' : 'n/a');\nconst list = (a, n) => a.length\n  ? esc(a.slice(0, n).join(', ')) + (a.length > n ? ' (+' + (a.length - n) + ' more)' : '')\n  : 'none';\n\nconst a = base.ipintel;\nconst b = base.internetdb;\n\nconst srcA = a.status === 'success'\n  ? [\n      '📍 ' + esc([a.city, a.region, a.country].filter(Boolean).join(', ')),\n      '🏢 ' + esc(a.org || a.isp) + ' (' + esc(a.asn) + ')',\n      '🔁 rDNS: ' + esc(a.reverse),\n      '🚩 Proxy/VPN: ' + yn(a.proxy) + ' · Hosting: ' + yn(a.hosting) + ' · Mobile: ' + yn(a.mobile)\n    ].join('\\n')\n  : 'No data (' + esc(a.message || 'lookup failed') + ')';\n\nconst srcB = b.noData\n  ? 'No record in Shodan InternetDB (not seen exposing services; this is not proof of safety)'\n  : [\n      '🔌 Open ports: ' + list(b.ports, 12),\n      '🌐 Hostnames: ' + list(b.hostnames, 5),\n      '🏷 Tags: ' + list(b.tags, 8),\n      '🐞 CVEs: ' + (b.vulns.length ? list(b.vulns, 5) : 'none listed')\n    ].join('\\n');\n\nconst text = [\n  badge + ' <b>' + verdict + '</b> — <code>' + esc(base.ip) + '</code>' +\n    (r.confidence ? ' (confidence: ' + esc(r.confidence) + ')' : ''),\n  '',\n  '🧠 <b>AI reasoning</b>',\n  esc(r.reasoning || 'The AI agent did not return a parsable verdict.'),\n  '',\n  '📡 <b>Source 1 — ip-api.com</b>',\n  srcA,\n  '',\n  '🔎 <b>Source 2 — Shodan InternetDB</b>',\n  srcB\n].join('\\n');\n\nreturn [{ json: { chatId: base.chatId, text, verdict } }];"
      },
