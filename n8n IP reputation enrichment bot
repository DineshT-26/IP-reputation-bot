      "parameters": {
        "jsCode": "const msg = $input.first().json.message || {};\nconst text = (msg.text || '').trim();\nconst chatId = msg.chat && msg.chat.id;\nconst m = text.match(/^\\/ioc(?:@\\w+)?\\s+(\\S+)/i);\nconst ip = m ? m[1] : '';\nconst v4 = /^((25[0-5]|2[0-4]\\d|1\\d\\d|[1-9]?\\d)\\.){3}(25[0-5]|2[0-4]\\d|1\\d\\d|[1-9]?\\d)$/;\nconst v6 = /^[0-9a-f:]+$/i;\nconst valid = v4.test(ip) || (ip.includes(':') && v6.test(ip));\nreturn [{ json: { chatId, ip, valid } }];"
      },
